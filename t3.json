{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "src/main/resources/webaom.png",
  "scripts": [
    {
      "name": "Run",
      "command": "./gradlew run",
      "icon": "play",
      "stopOnSettle": true
    },
    {
